{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Custom UI Configuration Schema",
  "type": "object",
  "properties": {
    "brand": {
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "windowTitle": { "type": "string" },
        "icon": { "type": "string" },
        "logoUrl": { "type": "string" },
        "about": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "version": { "type": "string" },
            "company": { "type": "string" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["default", "emerald", "roomba", "ocean", "amber", "purple", "midnight", "light"]
        },
        "colors": {
          "type": "object",
          "properties": {
            "primaryBase": { "type": "string" },
            "primaryHover": { "type": "string" },
            "surfaceBase": { "type": "string" },
            "surfacePanel": { "type": "string" },
            "surfaceHover": { "type": "string" },
            "borderBase": { "type": "string" },
            "borderFocus": { "type": "string" },
            "borderError": { "type": "string" },
            "textBase": { "type": "string" },
            "textMuted": { "type": "string" },
            "textInverse": { "type": "string" },
            "dangerBase": { "type": "string" },
            "dangerHover": { "type": "string" },
            "accentAnchor": { "type": "string" },
            "accentGenerator": { "type": "string" },
            "accentReference": { "type": "string" },
            "accentAutomation": { "type": "string" },
            "statusSuccess": { "type": "string" },
            "statusWarning": { "type": "string" },
            "occupancyFree": { "type": "string" },
            "occupancyObstacle": { "type": "string" },
            "occupancyUnknown": { "type": "string" }
          }
        },
        "colorScheme": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "cssVariables": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "customCssPath": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "showWelcomeModal": { "type": "boolean" },
        "topMenu": {
          "type": "object",
          "properties": {
            "hiddenMenuLabels": { "type": "array", "items": { "type": "string" } },
            "hiddenItemIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "toolPanel": {
          "type": "object",
          "properties": {
            "visibleTools": {
              "type": "array",
              "items": { "type": "string", "enum": ["select", "add_point", "add_generator", "add_rect_sweep", "add_export_region"] }
            },
            "allowImport": { "type": "boolean" },
            "allowExport": { "type": "boolean" },
            "allowSettings": { "type": "boolean" }
          }
        },
        "leftPanel": {
          "type": "object",
          "properties": {
            "defaultOpen": { "type": "boolean" },
            "defaultWidth": { "type": "number" },
            "viewMode": { "type": "string", "enum": ["tabs", "split"] },
            "tabs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "id", "title"],
                "properties": {
                  "type": { "type": "string", "enum": ["builtin", "workflow", "html_file", "html_inline", "url"] },
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "src": { "type": "string" },
                  "html": { "type": "string" },
                  "css": { "type": "string" },
                  "url": { "type": "string" }
                }
              }
            }
          }
        },
        "rightPanel": {
          "type": "object",
          "properties": {
            "defaultOpen": { "type": "boolean" },
            "defaultWidth": { "type": "number" },
            "viewMode": { "type": "string", "enum": ["tabs", "split"] },
            "tabs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "id", "title"],
                "properties": {
                  "type": { "type": "string", "enum": ["builtin", "workflow", "html_file", "html_inline", "url"] },
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "src": { "type": "string" },
                  "html": { "type": "string" },
                  "css": { "type": "string" },
                  "url": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "actionButton": {
                "type": "object",
                "required": ["label", "action"],
                "properties": {
                  "label": { "type": "string" },
                  "action": { "type": "string" },
                  "args": { "type": "object" },
                  "variant": { "type": "string", "enum": ["primary", "secondary", "outline", "danger", "ghost"] },
                  "icon": { "type": "string" },
                  "description": { "type": "string" },
                  "fullWidth": { "type": "boolean" },
                  "disabled": { "type": "boolean" }
                }
              },
              "actionButtons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "action"],
                  "properties": {
                    "label": { "type": "string" },
                    "action": { "type": "string" },
                    "args": { "type": "object" },
                    "variant": { "type": "string", "enum": ["primary", "secondary", "outline", "danger", "ghost"] },
                    "icon": { "type": "string" },
                    "description": { "type": "string" },
                    "saveToVariable": { "type": "string" },
                    "groupName": { "type": "string" },
                    "allowedAnnotationTools": { "type": "array", "items": { "type": "string" } },
                    "fullWidth": { "type": "boolean" },
                    "disabled": { "type": "boolean" }
                  }
                }
              },
              "buttonsLayout": {
                "type": "string",
                "enum": ["column", "grid", "row"]
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "target", "label"],
                  "properties": {
                    "type": { "type": "string", "enum": ["slider", "number", "boolean", "select"] },
                    "target": {
                      "type": "object",
                      "required": ["action"],
                      "properties": {
                        "action": { "type": "string" },
                        "args": { "type": "object" }
                      }
                    },
                    "label": { "type": "string" },
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "step": { "type": "number" },
                    "default": {},
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "properties": {
                          "label": { "type": "string" },
                          "value": {}
                        }
                      }
                    }
                  }
                }
              },
              "pluginTarget": { "type": "string" },
              "showPluginInputs": { "type": "boolean" },
              "pluginInputsFilter": { "type": "array", "items": { "type": "string" } },
              "pluginInputsConfig": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "description": { "type": "string" },
                    "defaultName": { "type": "string" }
                  }
                }
              },
              "allowedAnnotationTools": { "type": "array", "items": { "type": "string" } },
              "simplifiedParams": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["paramKey", "type"],
                  "properties": {
                    "paramKey": { "type": "string" },
                    "label": { "type": "string" },
                    "type": { "type": "string", "enum": ["slider", "select", "number", "boolean"] },
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "step": { "type": "number" },
                    "default": {},
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "properties": {
                          "label": { "type": "string" },
                          "value": {}
                        }
                      }
                    }
                  }
                }
              },
              "onEnter": {
                "type": "object",
                "properties": {
                  "actions": { "type": "array", "items": { "type": "string" } },
                  "state": { "type": "object" }
                }
              },
              "onLeave": {
                "type": "object",
                "properties": {
                  "actions": { "type": "array", "items": { "type": "string" } },
                  "state": { "type": "object" }
                }
              }
            }
          }
        }
      }
    }
  }
}

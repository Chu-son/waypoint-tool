{
  "$schema": "../../schema/custom-ui-config.schema.json",
  "brand": {
    "appName": "Roomba Route Creator",
    "windowTitle": "Roomba Route Creator - お掃除経路エディタ",
    "icon": "Bot",
    "about": {
      "title": "Roomba Route Creator v1.0",
      "description": "初心者向けお掃除ロボット経路設定ツール",
      "company": "Robotics Clean Solutions"
    }
  },
  "theme": {
    "cssVariables": {
      "--color-primary-base": "#10b981",
      "--color-primary-hover": "#059669"
    }
  },
  "layout": {
    "showWelcomeModal": false,
    "topMenu": {
      "hiddenItemIds": ["help_devtools", "file_export_maps"]
    },
    "toolPanel": {
      "visibleTools": ["select", "add_point", "add_rect_sweep"],
      "allowImport": false,
      "allowExport": true,
      "allowSettings": false
    },
    "leftPanel": {
      "defaultOpen": true,
      "defaultWidth": 340,
      "viewMode": "tabs",
      "tabs": [
        { "type": "workflow", "id": "workflow", "title": "お掃除手順ガイド" },
        { "type": "builtin", "id": "project", "title": "詳細地点一覧" }
      ]
    },
    "rightPanel": {
      "defaultOpen": true,
      "defaultWidth": 320,
      "viewMode": "tabs",
      "tabs": [
        { "type": "builtin", "id": "inspector", "title": "属性設定" },
        { "type": "builtin", "id": "layers", "title": "マップレイヤー" }
      ]
    }
  },
  "workflow": {
    "id": "roomba_cleaning_flow",
    "title": "お掃除ルート作成ワークフロー",
    "steps": [
      {
        "id": "step_project",
        "title": "1. プロジェクトの準備",
        "description": "新しいお掃除計画を作成するか、保存済みのプロジェクトを開きます。",
        "actionButtons": [
          {
            "label": "新規プロジェクト作成",
            "action": "reset_project",
            "variant": "secondary",
            "icon": "FilePlus",
            "description": "現在の内容を初期化して新規作成します"
          },
          {
            "label": "プロジェクトを開く",
            "action": "open_project_dialog",
            "variant": "primary",
            "icon": "FolderOpen",
            "description": "保存済みの .wptroj ファイルを読み込みます"
          }
        ],
        "buttonsLayout": "column"
      },
      {
        "id": "step_map",
        "title": "2. マップの読み込み",
        "description": "間取りマップ画像（PGM / PNG / YAML）を読み込んでキャンバスに表示します。",
        "actionButtons": [
          {
            "label": "マップファイルを開く",
            "action": "open_map_dialog",
            "variant": "primary",
            "icon": "Map",
            "description": "ROS マップまたは間取り画像を読み込みます"
          }
        ],
        "onEnter": { "actions": ["triggerFitToMaps"] }
      },
      {
        "id": "step_robot_params",
        "title": "3. ロボットパラメータ設定",
        "description": "お掃除ロボットの寸法や走行パラメータを設定します。",
        "controls": [
          {
            "type": "slider",
            "target": { "action": "setRobotFootprintRadius" },
            "label": "ロボット半径 (m)",
            "min": 0.1,
            "max": 0.5,
            "step": 0.01,
            "default": 0.18
          }
        ],
        "actionButtons": [
          {
            "label": "詳細ロボット設定を開く",
            "action": "open_settings_modal",
            "args": { "tab": "robot" },
            "variant": "secondary",
            "icon": "Settings",
            "description": "矩形形状や詳細オフセットを設定できます"
          }
        ],
        "onEnter": { "state": { "showFootprints": true } }
      },
      {
        "id": "step_environment",
        "title": "4. 環境設定",
        "description": "アノテーションのポイント配置、障害物のアノテーション矩形配置、ノイズ消去のレイヤー配置を設定します。",
        "actionButtons": [
          {
            "label": "障害物ポイント配置",
            "action": "set_annotation_tool",
            "args": { "tool": "point", "defaultColor": "#ef4444", "defaultName": "障害物" },
            "groupName": "障害物ポイント",
            "allowedAnnotationTools": ["point"],
            "saveToVariable": "obstacle_points_group",
            "variant": "secondary",
            "icon": "MapPin",
            "description": "進入不可地点をポイントで配置（専用グループに格納）"
          },
          {
            "label": "障害物矩形エリア配置",
            "action": "set_annotation_tool",
            "args": { "tool": "rect", "defaultColor": "#ef4444", "defaultName": "進入禁止エリア" },
            "groupName": "障害物エリア",
            "allowedAnnotationTools": ["rect"],
            "saveToVariable": "obstacle_rects_group",
            "variant": "secondary",
            "icon": "Square",
            "description": "進入禁止矩形エリアを配置"
          },
          {
            "label": "ノイズ消去レイヤー配置",
            "action": "start_map_edit",
            "args": { "subTool": "circle", "fillValue": 0, "brushSize": 15, "layerName": "ノイズ消去" },
            "variant": "secondary",
            "icon": "Eraser",
            "description": "マップ上のゴミや不要なピクセルを消去"
          }
        ],
        "buttonsLayout": "column"
      },
      {
        "id": "step_cleaning_area",
        "title": "5. 清掃エリアの指定と可能範囲計算",
        "description": "マップ上で清掃を行いたい矩形領域（またはシード点）を指定し、清掃可能範囲のレイヤーを計算します。",
        "pluginTarget": "drivable_area_layer_generator",
        "showPluginInputs": true,
        "pluginInputsConfig": [
          {
            "id": "sweep_rect",
            "label": "清掃対象エリア (矩形)",
            "description": "マップ上で掃除を行いたい範囲をドラッグして囲んでください"
          }
        ],
        "simplifiedParams": [
          {
            "paramKey": "max_radius",
            "label": "最大展開距離 (m)",
            "type": "slider",
            "min": 5,
            "max": 30,
            "step": 1,
            "default": 15
          },
          {
            "paramKey": "extra_margin",
            "label": "安全クリアランスマージン (m)",
            "type": "slider",
            "min": 0,
            "max": 0.3,
            "step": 0.01,
            "default": 0.05
          }
        ],
        "actionButtons": [
          {
            "label": "清掃可能範囲を計算 (カスタムレイヤー)",
            "action": "run_active_plugin",
            "variant": "primary",
            "icon": "Layers",
            "description": "指定した清掃範囲矩形内の走行可能エリアを計算してレイヤーを生成（何度でも再生成可能）"
          }
        ]
      },
      {
        "id": "step_generate_path",
        "title": "6. 経路生成",
        "description": "清掃範囲に対してジグザグ走査経路を自動生成します。",
        "pluginTarget": "rect_search_generator",
        "showPluginInputs": true,
        "pluginInputsConfig": [
          {
            "id": "sweep_rect",
            "label": "走査走査範囲 (矩形)",
            "description": "経路を生成する対象矩形を指定します"
          }
        ],
        "simplifiedParams": [
          {
            "paramKey": "num_lines",
            "label": "お掃除の細かさ (走査線数)",
            "type": "select",
            "options": [
              { "label": "標準 (5ライン)", "value": 5 },
              { "label": "念入り (10ライン)", "value": 10 },
              { "label": "高速 (3ライン)", "value": 3 }
            ]
          }
        ],
        "actionButtons": [
          {
            "label": "清掃経路を自動生成する",
            "action": "run_active_plugin",
            "args": {
              "interactionData": {
                "obstacles": { "$fromAnnotationGroup": "$var:obstacle_points_group" }
              }
            },
            "variant": "primary",
            "icon": "Play",
            "description": "指定した領域内にストライプ走査のウェイポイント列を一括生成します（再実行時は上書き再生成）"
          }
        ]
      },
      {
        "id": "step_save_export",
        "title": "7. 保存",
        "description": "作成した清掃計画をプロジェクトとして保存、またはロボット用形式で書き出します。",
        "actionButtons": [
          {
            "label": "プロジェクトを保存",
            "action": "save_project",
            "variant": "primary",
            "icon": "Save",
            "description": ".wptroj 形式で全データを保存します"
          },
          {
            "label": "ロボット用ファイル書き出し (Export)",
            "action": "open_export_modal",
            "variant": "secondary",
            "icon": "Download",
            "description": "YAML / JSON / ROS2 形式でエクスポート"
          },
          {
            "label": "マップ画像一括出力",
            "action": "open_export_maps_modal",
            "variant": "outline",
            "icon": "Image",
            "description": "編集済みマップを画像ファイルとして出力"
          }
        ],
        "buttonsLayout": "column"
      }
    ]
  }
}

{
    "name": "Interpolation Generator",
    "version": "2.1.0",
    "description": "StartとEndの間のウェイポイントを、指定した最大間隔以下になるように細分化します。範囲内のグループやジェネレーターの中の点も対象にできます（「グループ内も補間する」で切り替え）。元の点は保持されており、ジェネレーターの「元に戻す」でグループの階層ごと元の状態に戻せます。",
    "type": "python",
    "executable": "main.py",
    "inputs": [
        {
            "id": "start_node",
            "label": "Start Waypoint",
            "type": "waypoint"
        },
        {
            "id": "end_node",
            "label": "End Waypoint",
            "type": "waypoint"
        }
    ],
    "needs": ["waypoint_range"],
    "properties": [
        {
            "name": "max_pitch",
            "label": "最大間隔 (m)",
            "type": "float",
            "default": 1.0
        },
        {
            "name": "include_groups",
            "label": "グループ内も補間する",
            "type": "boolean",
            "default": true
        },
        {
            "name": "enabled",
            "label": "細分化を有効にする",
            "type": "boolean",
            "default": true
        }
    ]
}

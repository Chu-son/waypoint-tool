{
  "name": "Drivable Area Layer Generator",
  "category": "map_layer_generator",
  "version": "1.3.0",
  "description": "Expands drivable area from interactive seed points using multi-source flood-fill with robot footprint clearance, unknown space handling, and customizable overlay colors.",
  "type": "python",
  "executable": "main.py",
  "icon": "Sparkles",
  "inputs": [
    {
      "id": "sweep_rect",
      "label": "Cleaning Area (Rectangle)",
      "type": "rectangle",
      "description": "清掃範囲の矩形領域を指定します（省略時はシード点またはマップ全体から展開）"
    },
    {
      "id": "seed_points",
      "label": "Seed Points",
      "type": "points",
      "min_points": 0,
      "max_points": 50,
      "allow_yaw": false,
      "description": "展開を開始するシード点（省略時は矩形中心）"
    }
  ],
  "needs": ["occupancy_grid", "robot_footprint"],
  "properties": [
    {
      "name": "max_radius",
      "label": "Max Expansion Radius (m)",
      "type": "float",
      "default": 10.0
    },
    {
      "name": "use_robot_footprint",
      "label": "Consider Robot Footprint",
      "type": "boolean",
      "default": true
    },
    {
      "name": "extra_margin",
      "label": "Extra Clearance Margin (m)",
      "type": "float",
      "default": 0.05
    },
    {
      "name": "allow_unknown",
      "label": "Allow Unknown Space",
      "type": "boolean",
      "default": false,
      "description": "If enabled, unknown/unmapped areas are also considered traversable."
    },
    {
      "name": "dilation_cells",
      "label": "Dilation Width (cells)",
      "type": "integer",
      "default": 0
    },
    {
      "name": "layer_color",
      "label": "Layer Color",
      "type": "color",
      "default": "#22c55e"
    },
    {
      "name": "fill_opacity",
      "label": "Fill Opacity (0~1)",
      "type": "float",
      "default": 0.6
    }
  ]
}
